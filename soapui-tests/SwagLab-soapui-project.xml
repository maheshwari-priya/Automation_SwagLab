<?xml version="1.0" encoding="UTF-8"?>
<con:soapui-project xmlns:con="http://eviware.com/soapui/config" activeEnvironment="Default"
    name="SwagLab-SOAP-CalculatorService" resourceRoot="" soapui-version="5.7.0">

    <con:interface xsi:type="con:WsdlInterface" name="CalculatorSoap" title="CalculatorSoap"
        type="wsdl" bindingName="{http://tempuri.org/}CalculatorSoap"
        soapVersion="1_1" anonymous="optional" definition="http://www.dneonline.com/calculator.asmx?WSDL"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

        <con:endpoints>
            <con:endpoint>http://www.dneonline.com/calculator.asmx</con:endpoint>
        </con:endpoints>

        <con:operation isOneWay="false" action="http://tempuri.org/Add" name="Add"
            bindingOperationName="Add" type="Request-Response" outputName="AddResponse">
            <con:call name="Add">
                <con:request name="Add">
                    <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/">
   <soapenv:Header/>
   <soapenv:Body>
      <tem:Add>
         <tem:intA>10</tem:intA>
         <tem:intB>15</tem:intB>
      </tem:Add>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
                </con:request>
            </con:call>
        </con:operation>

        <con:operation isOneWay="false" action="http://tempuri.org/Subtract" name="Subtract"
            bindingOperationName="Subtract" type="Request-Response" outputName="SubtractResponse">
            <con:call name="Subtract">
                <con:request name="Subtract">
                    <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/">
   <soapenv:Header/>
   <soapenv:Body>
      <tem:Subtract>
         <tem:intA>20</tem:intA>
         <tem:intB>8</tem:intB>
      </tem:Subtract>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
                </con:request>
            </con:call>
        </con:operation>

        <con:operation isOneWay="false" action="http://tempuri.org/Multiply" name="Multiply"
            bindingOperationName="Multiply" type="Request-Response" outputName="MultiplyResponse">
            <con:call name="Multiply">
                <con:request name="Multiply">
                    <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/">
   <soapenv:Header/>
   <soapenv:Body>
      <tem:Multiply>
         <tem:intA>6</tem:intA>
         <tem:intB>7</tem:intB>
      </tem:Multiply>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
                </con:request>
            </con:call>
        </con:operation>

        <con:operation isOneWay="false" action="http://tempuri.org/Divide" name="Divide"
            bindingOperationName="Divide" type="Request-Response" outputName="DivideResponse">
            <con:call name="Divide">
                <con:request name="Divide">
                    <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/">
   <soapenv:Header/>
   <soapenv:Body>
      <tem:Divide>
         <tem:intA>100</tem:intA>
         <tem:intB>4</tem:intB>
      </tem:Divide>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
                </con:request>
            </con:call>
        </con:operation>

        <con:operation isOneWay="false" action="http://tempuri.org/Divide" name="Divide_By_Zero"
            bindingOperationName="Divide" type="Request-Response" outputName="DivideResponse">
            <con:call name="Divide_By_Zero">
                <con:request name="Divide_By_Zero">
                    <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/">
   <soapenv:Header/>
   <soapenv:Body>
      <tem:Divide>
         <tem:intA>50</tem:intA>
         <tem:intB>0</tem:intB>
      </tem:Divide>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
                </con:request>
            </con:call>
        </con:operation>

    </con:interface>

    <con:testSuite name="TestSuite">
        <con:testCase failOnError="true" failTestCaseOnErrors="true" name="Calculator SOAP Test Case" maxResults="0">

            <con:testStep type="request" name="TC01 - Add">
                <con:config xsi:type="con:RequestStep" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                    <con:interface>CalculatorSoap</con:interface>
                    <con:operation>Add</con:operation>
                    <con:request name="TC01 - Add">
                        <con:assertion type="Valid HTTP Status Codes" name="Valid HTTP Status Codes">
                            <con:configuration><codes>200</codes></con:configuration>
                        </con:assertion>
                        <con:assertion type="SOAP Response" name="SOAP Response"/>
                        <con:assertion type="Simple Contains" name="Contains AddResult 25">
                            <con:configuration><token>&lt;AddResult&gt;25&lt;/AddResult&gt;</token><ignoreCase>true</ignoreCase></con:configuration>
                        </con:assertion>
                        <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/">
   <soapenv:Header/>
   <soapenv:Body>
      <tem:Add>
         <tem:intA>10</tem:intA>
         <tem:intB>15</tem:intB>
      </tem:Add>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
                    </con:request>
                </con:config>
            </con:testStep>

            <con:testStep type="request" name="TC02 - Subtract">
                <con:config xsi:type="con:RequestStep" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                    <con:interface>CalculatorSoap</con:interface>
                    <con:operation>Subtract</con:operation>
                    <con:request name="TC02 - Subtract">
                        <con:assertion type="Valid HTTP Status Codes" name="Valid HTTP Status Codes">
                            <con:configuration><codes>200</codes></con:configuration>
                        </con:assertion>
                        <con:assertion type="SOAP Response" name="SOAP Response"/>
                        <con:assertion type="Simple Contains" name="Contains SubtractResult 12">
                            <con:configuration><token>&lt;SubtractResult&gt;12&lt;/SubtractResult&gt;</token><ignoreCase>true</ignoreCase></con:configuration>
                        </con:assertion>
                        <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/">
   <soapenv:Header/>
   <soapenv:Body>
      <tem:Subtract>
         <tem:intA>20</tem:intA>
         <tem:intB>8</tem:intB>
      </tem:Subtract>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
                    </con:request>
                </con:config>
            </con:testStep>

            <con:testStep type="request" name="TC03 - Multiply">
                <con:config xsi:type="con:RequestStep" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                    <con:interface>CalculatorSoap</con:interface>
                    <con:operation>Multiply</con:operation>
                    <con:request name="TC03 - Multiply">
                        <con:assertion type="Valid HTTP Status Codes" name="Valid HTTP Status Codes">
                            <con:configuration><codes>200</codes></con:configuration>
                        </con:assertion>
                        <con:assertion type="SOAP Response" name="SOAP Response"/>
                        <con:assertion type="Simple Contains" name="Contains MultiplyResult 42">
                            <con:configuration><token>&lt;MultiplyResult&gt;42&lt;/MultiplyResult&gt;</token><ignoreCase>true</ignoreCase></con:configuration>
                        </con:assertion>
                        <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/">
   <soapenv:Header/>
   <soapenv:Body>
      <tem:Multiply>
         <tem:intA>6</tem:intA>
         <tem:intB>7</tem:intB>
      </tem:Multiply>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
                    </con:request>
                </con:config>
            </con:testStep>

            <con:testStep type="request" name="TC04 - Divide">
                <con:config xsi:type="con:RequestStep" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                    <con:interface>CalculatorSoap</con:interface>
                    <con:operation>Divide</con:operation>
                    <con:request name="TC04 - Divide">
                        <con:assertion type="Valid HTTP Status Codes" name="Valid HTTP Status Codes">
                            <con:configuration><codes>200</codes></con:configuration>
                        </con:assertion>
                        <con:assertion type="SOAP Response" name="SOAP Response"/>
                        <con:assertion type="Simple Contains" name="Contains DivideResult 25">
                            <con:configuration><token>&lt;DivideResult&gt;25&lt;/DivideResult&gt;</token><ignoreCase>true</ignoreCase></con:configuration>
                        </con:assertion>
                        <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/">
   <soapenv:Header/>
   <soapenv:Body>
      <tem:Divide>
         <tem:intA>100</tem:intA>
         <tem:intB>4</tem:intB>
      </tem:Divide>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
                    </con:request>
                </con:config>
            </con:testStep>

            <con:testStep type="request" name="TC05 - Divide By Zero (Edge Case)">
                <con:config xsi:type="con:RequestStep" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                    <con:interface>CalculatorSoap</con:interface>
                    <con:operation>Divide</con:operation>
                    <con:request name="TC05 - Divide By Zero (Edge Case)">
                        <con:assertion type="Valid HTTP Status Codes" name="Valid HTTP Status Codes">
                            <con:configuration><codes>200,500</codes></con:configuration>
                        </con:assertion>
                        <con:request><![CDATA[<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:tem="http://tempuri.org/">
   <soapenv:Header/>
   <soapenv:Body>
      <tem:Divide>
         <tem:intA>50</tem:intA>
         <tem:intB>0</tem:intB>
      </tem:Divide>
   </soapenv:Body>
</soapenv:Envelope>]]></con:request>
                    </con:request>
                </con:config>
            </con:testStep>

        </con:testCase>
    </con:testSuite>

    <con:properties/>
</con:soapui-project>
